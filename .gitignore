# Project-specific
exports/
data/*.npy
# ...but bundle the BrainWeb brain phantom so the brain renders out-of-the-box.
!data/brainweb_sub04_anat.npy
# ...and the precomputed brain vessel-tree indices (so SWI/MRA skip the ~1 min build).
!data/brain_vessels_idx.npy
# Keep the bulky raw TotalSegMRI dataset out of git, but DO bundle the small
# per-region caches (atlas + texture) for the four regions the app ships, so the
# downloaded binaries render real body anatomy. Re-including files requires
# un-ignoring each parent directory along the path first.
data/TotalsegmentatorMRI_dataset_v*/**
!data/TotalsegmentatorMRI_dataset_v*/
!data/TotalsegmentatorMRI_dataset_v*/s0246/
!data/TotalsegmentatorMRI_dataset_v*/s0267/
!data/TotalsegmentatorMRI_dataset_v*/s0187/
!data/TotalsegmentatorMRI_dataset_v*/s0250/
!data/TotalsegmentatorMRI_dataset_v*/s0*/atlas_iso_adapt_256.npy
!data/TotalsegmentatorMRI_dataset_v*/s0*/texture_iso_adapt_256.npy
examples/output/

# Web build artifacts (regenerated by build_web.py / the deploy workflow)
web/mrisim_src.zip
web/data/
web/logo.png
web/data/regions/
web/build_id.js
web/lessons.json

# Node tooling (ESLint for the web build)
node_modules/

# Legacy PNG output of scripts/prerender_lessons.py (it now writes optimized .jpg)
web/img/lessons/**/*.png

# scratch: quiz rebalance option-patch files (applied via scripts/apply_quiz_patch.py)
patches/

# Source PDFs for course content (local only; mined into data/course_content.json, not app assets)
pdf education/

# Playwright MCP browser-session artifacts (snapshots, console logs)
.playwright-mcp/
